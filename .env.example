PORT=4000

# Supabase Credentials
DATABASE_URL="postgresql://..."
DIRECT_URL="postgresql://..."
SUPABASE_URL="https://..."
SUPABASE_STORAGE_BUCKET="..."
SUPABASE_SERVICE_ROLE_KEY="..."

# Resend Credentials
RESEND_API_KEY="..."
EMAIL_FROM="support@qubeex.in"

# Default Credentials
JWT_SECRET="..."

CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://localhost:3001"
FRONTEND_URL="http://localhost:3000"

# SuperAdmin Credentials
SUPERADMINS=[{"email":"...","password":"..."}]

# Upstash Credentials
UPSTASH_REDIS_REST_URL="..."
UPSTASH_REDIS_REST_TOKEN="..."
REDIS_URL="..."

NODE_ENV="development"

# Cloudflare storage setup
R2_ACCOUNT_ID="..."
R2_ACCESS_KEY_ID="..."
R2_SECRET_ACCESS_KEY="..."
R2_BUCKET_NAME="qubeex-media"
R2_PUBLIC_URL="..."
R2_ENDPOINT="..."

# AI API Keys
GROQ_API_KEY="..."

# Blackboard AI Scan — image search (optional, pick ONE; Serper wins if both set).
#
# Serper (preferred — cheaper per query, 2,500 free queries to start).
# Get a key at https://serper.dev. Serper exposes no license filter; instead
# blackboard.controller.ts hard-blocks unusable sources (stock/watermarked,
# pinboards, AI-generated, video thumbnails) and ranks known educational
# publishers first — see BLOCKED_IMAGE_DOMAINS / PREFERRED_IMAGE_DOMAINS.
SERPER_API_KEY="..."

# Fills Wikipedia's coverage gaps for niche topics that have no curated 
# image. When unset, image retrieval silently falls back to Wikipedia only.
# Setup: create a Google Cloud API key with the Custom Search API enabled, then
# a Programmable Search Engine (https://programmablesearchengine.google.com)
# with "Image search" ON and "Search the entire web" ON — its ID is the cx value.
# Results are restricted to openly-licensed images (see GOOGLE_IMAGE_LICENSE_FILTER
# in blackboard.controller.ts). Free tier is 100 queries/day, then billed per query.
GOOGLE_SEARCH_API_KEY="..."
GOOGLE_SEARCH_CX="..."

# Razorpay (use test keys in dev, live keys in prod)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...
