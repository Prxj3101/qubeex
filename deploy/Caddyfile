# Caddy gets a free HTTPS certificate for API_DOMAIN automatically
# and forwards every request to the backend container.
{$API_DOMAIN} {
	encode gzip
	request_body {
		max_size 50MB
	}
	# /api/internal/* is only for containers on the server (Traccar -> backend),
	# never from the internet
	@internal path /api/internal/*
	respond @internal 404
	reverse_proxy backend:3000
}
