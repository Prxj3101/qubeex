  @@index([purchaseOrderId])
  adjustmentType String?
  deliveredQuantity Decimal? @db.Decimal(14, 3)
  rejectedQuantity Decimal @default(0) @db.Decimal(14, 3)
  damageReason String @default("")
  transferId String?
  transferLocationId String?
  transferLocationName String @default("")
