  configs    TimetableSubjectConfig[]
  entries    TimetableEntry[]
  exceptions TimetableException[]

  @@unique([institutionId, name])
  @@index([institutionId])
}

model Room {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  name          String
  type          String      @default("CLASSROOM")
  capacity      Int?
  isActive      Boolean     @default(true)
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  unavailability RoomUnavailability[]
  configs        TimetableSubjectConfig[]
  entries        TimetableEntry[]
  exceptions     TimetableException[]

  @@unique([institutionId, name])
  @@index([institutionId])
}

model RoomUnavailability {
  id             String       @id @default(uuid())
  institutionId  String
  institution    Institution  @relation(fields: [institutionId], references: [id])
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  roomId         String
  room           Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  dayOfWeek      Int
  slotId         String
  slot           TimeSlot     @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@unique([roomId, academicYearId, dayOfWeek, slotId])
  @@index([institutionId, academicYearId])
}

model TeacherAvailability {
  id             String           @id @default(uuid())
  institutionId  String
  institution    Institution      @relation(fields: [institutionId], references: [id])
  academicYearId String
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id])
  teacherId      String
  teacher        Teacher          @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  dayOfWeek      Int
  slotId         String
  slot           TimeSlot         @relation(fields: [slotId], references: [id], onDelete: Cascade)
  kind           AvailabilityKind @default(UNAVAILABLE)

  @@unique([teacherId, academicYearId, dayOfWeek, slotId])
  @@index([institutionId, academicYearId])
}

model TeacherTimetablePref {
  id                String       @id @default(uuid())
  institutionId     String
  institution       Institution  @relation(fields: [institutionId], references: [id])
  academicYearId    String
  academicYear      AcademicYear @relation(fields: [academicYearId], references: [id])
  teacherId         String
  teacher           Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  maxPeriodsPerDay  Int?
  maxConsecutive    Int?
  maxPeriodsPerWeek Int?

  @@unique([teacherId, academicYearId])
  @@index([institutionId, academicYearId])
}

model SchoolTimetable {
  id             String          @id @default(uuid())
  institutionId  String
  institution    Institution     @relation(fields: [institutionId], references: [id])
  academicYearId String
  academicYear   AcademicYear    @relation(fields: [academicYearId], references: [id])
  divisionId     String
  division       Division        @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  status         TimetableStatus @default(DRAFT)
  generatedAt    DateTime?
  publishedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  entries     TimetableEntry[]
  generations TimetableGeneration[]

  @@unique([divisionId, academicYearId])
  @@index([institutionId, academicYearId])
}

model TimetableSubjectConfig {
  id             String               @id @default(uuid())
  institutionId  String
  institution    Institution          @relation(fields: [institutionId], references: [id])
  academicYearId String
  academicYear   AcademicYear         @relation(fields: [academicYearId], references: [id])
  divisionId     String
  division       Division             @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  subjectId      String?
  subject        Subject?             @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  sessionTypeId  String
  sessionType    TimetableSessionType @relation(fields: [sessionTypeId], references: [id])
  title          String?
  periodsPerWeek Int                  @default(1)
  span           Int                  @default(1)
  maxPerDay      Int                  @default(1)
  teacherId      String?
  teacher        Teacher?             @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  roomId         String?
  room           Room?                @relation(fields: [roomId], references: [id], onDelete: SetNull)
  roomType       String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  entries TimetableEntry[]

  @@index([institutionId, academicYearId, divisionId])
}

model TimetableEntry {
  id             String                  @id @default(uuid())
  institutionId  String
  institution    Institution             @relation(fields: [institutionId], references: [id])
  academicYearId String
  academicYear   AcademicYear            @relation(fields: [academicYearId], references: [id])
  timetableId    String
  timetable      SchoolTimetable         @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  divisionId     String
  division       Division                @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  dayOfWeek      Int
  slotId         String
  slot           TimeSlot                @relation(fields: [slotId], references: [id], onDelete: Cascade)
  sessionTypeId  String
  sessionType    TimetableSessionType    @relation(fields: [sessionTypeId], references: [id])
  subjectId      String?
  subject        Subject?                @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  title          String?
  teacherId      String?
  teacher        Teacher?                @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  roomId         String?
  room           Room?                   @relation(fields: [roomId], references: [id], onDelete: SetNull)
  configId       String?
  config         TimetableSubjectConfig? @relation(fields: [configId], references: [id], onDelete: SetNull)
  groupId        String?
  isLocked       Boolean                 @default(false)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  substitutions TimetableSubstitution[]

  @@unique([timetableId, dayOfWeek, slotId])
  @@index([institutionId, academicYearId])
  @@index([academicYearId, divisionId])
  @@index([academicYearId, teacherId, dayOfWeek])
  @@index([academicYearId, roomId, dayOfWeek])
}

model TimetableException {
  id             String                 @id @default(uuid())
  institutionId  String
  institution    Institution            @relation(fields: [institutionId], references: [id])
  academicYearId String
  academicYear   AcademicYear           @relation(fields: [academicYearId], references: [id])
  divisionId     String
  division       Division               @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  date           DateTime               @db.Date
  slotId         String
  slot           TimeSlot               @relation(fields: [slotId], references: [id], onDelete: Cascade)
  kind           TimetableExceptionKind @default(OVERRIDE)
  sessionTypeId  String?
  sessionType    TimetableSessionType?  @relation(fields: [sessionTypeId], references: [id])
  subjectId      String?
  subject        Subject?               @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  title          String?
  teacherId      String?
  teacher        Teacher?               @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  roomId         String?
  room           Room?                  @relation(fields: [roomId], references: [id], onDelete: SetNull)
  reason         String?
  createdById    String?
  createdAt      DateTime               @default(now())

  @@unique([divisionId, date, slotId])
  @@index([institutionId, academicYearId, date])
}

model TimetableSubstitution {
  id                  String         @id @default(uuid())
  institutionId       String
  institution         Institution    @relation(fields: [institutionId], references: [id])
  academicYearId      String
  academicYear        AcademicYear   @relation(fields: [academicYearId], references: [id])
  entryId             String
  entry               TimetableEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  date                DateTime       @db.Date
  originalTeacherId   String?
  substituteTeacherId String
  substituteTeacher   Teacher        @relation("SubstituteTeacher", fields: [substituteTeacherId], references: [id], onDelete: Cascade)
  reason              String?
  createdById         String?
  createdAt           DateTime       @default(now())

  @@unique([entryId, date])
  @@index([institutionId, academicYearId, date])
  @@index([substituteTeacherId, date])
}

model TimetableGeneration {
  id             String          @id @default(uuid())
  institutionId  String
  institution    Institution     @relation(fields: [institutionId], references: [id])
  academicYearId String
  academicYear   AcademicYear    @relation(fields: [academicYearId], references: [id])
  timetableId    String
  timetable      SchoolTimetable @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  complete       Boolean
  placed         Int
  unplaced       Int
  problems       Json?
  createdById    String?
  createdAt      DateTime        @default(now())

  @@index([timetableId, createdAt])
}

/// AI Timetable chat: what the admin asked and what the assistant answered, per academic year.
model TimetableAiMessage {
  id             String   @id @default(uuid())
  institutionId  String
  academicYearId String
  role           String
  text           String
  /// Steps, proposed actions, their state (open/applied/undone...) and the undo snapshot.
  data           Json?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([institutionId, academicYearId, createdAt])
}

/// A saved copy of the whole school's timetable (every build, AI change or restore), so the admin can go back.
model TimetableVersion {
  id             String   @id @default(uuid())
  institutionId  String
  academicYearId String
  number         Int
  label          String
  /// Every period at that moment: [{ divisionId, dayOfWeek, slotId, sessionTypeId, subjectId, title, teacherId, roomId, configId, groupId, isLocked }]
  entries        Json
  periods        Int
  createdById    String?
  createdAt      DateTime @default(now())

  @@index([institutionId, academicYearId, createdAt])
}

model InventorySetupOrder {
  institutionId String
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  kind String
  ids Json
  revision Int @default(1)
  updatedAt DateTime @updatedAt
  @@id([institutionId, kind])
}

// ── Admissions ─────────────────────────────────────────────────────────────
// One row per institution: how the school runs admissions. Kept free of
// relations so the BYOD tenant schema copies it as-is.
model AdmissionSettings {
  id                String   @id @default(uuid())
  institutionId     String   @unique
  academicYearId    String?
  formOpen          Boolean  @default(false)
  interactionStep   Boolean  @default(true)
  registrationFee   Decimal? @db.Decimal(12, 2)
  admissionFeeDays  Int      @default(7)
  ageCutoff         String   @default("06-01")
  ageRules          Json     @default("[]")
  fields            Json     @default("{}")
  questions         Json     @default("[]")
  documents         Json     @default("[]")
  /// The school's admission form (sections, fields, declaration). See admissions.form.ts.
  admissionForm     Json     @default("{}")
  admissionNoPrefix String   @default("")
  nextAdmissionNo   Int      @default(1)
  nextApplicationNo Int      @default(1)
  revision          Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// One child's admission, from first enquiry to placement in a section.
// Contact details live encrypted in `details` (AES-GCM, PII_ENC_KEY); only the
// child's name, parent's name and the phone's last 4 digits stay readable for
// search. No document files are ever stored - only who saw which original.
model AdmissionApplication {
  id              String   @id @default(uuid())
  institutionId   String
  academicYearId  String
  applicationNo   String
  standardId      String
  stage           String   @default("ENQUIRY")
  outcome         String?
  waitlistRank    Int?
  source          String   @default("COUNTER")
  childName       String
  dob             String?
  gender          String?
  parentName      String   @default("")
  phoneLast4      String   @default("")
  details         String
  registrationFee Json?
  interaction     Json?
  offer           Json?
  admissionFee    Json?
  documents       Json     @default("[]")
  /// Admission form status and values (values encrypted).
  admissionForm   Json?
  admissionNo     String?
  divisionId      String?
  studentId       String?
  statusToken     String   @unique
  revision        Int      @default(1)
  events          Json     @default("[]")
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([institutionId, applicationNo])
  @@unique([institutionId, admissionNo])
  @@index([institutionId, academicYearId, stage])
}

// ── Parent ↔ teacher chat ────────────────────────────────────────────────────
// Parent Mode lives inside the student's own login (no separate parent
// account), so the "parent" side of a thread is the student account. One thread
// per (student, teacher). Messages from the parent side are only ever sent to a
// teacher of the student's division; teachers reply in the same thread.

model ParentChatSettings {
  institutionId String   @id
  enabled       Boolean  @default(true)
  // "HH:mm" in IST. Messages sent outside this window are still accepted but
  // the teacher is not pushed, and the parent is told when to expect a reply.
  officeStart   String   @default("08:00")
  officeEnd     String   @default("18:00")
  updatedAt     DateTime @updatedAt
}

model ParentChatThread {
  id            String              @id @default(uuid())
  institutionId String
  studentId     String
  teacherId     String
  lastMessageAt DateTime            @default(now())
  createdAt     DateTime            @default(now())
  student       Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher       Teacher             @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  messages      ParentChatMessage[]

  @@unique([studentId, teacherId])
  @@index([institutionId, lastMessageAt])
  @@index([teacherId, lastMessageAt])
}

model ParentChatMessage {
  id              String           @id @default(uuid())
  institutionId   String
  threadId        String
  fromTeacher     Boolean
  senderUserId    String
  text            String
  // One optional attachment per message — "image" or "pdf", stored in R2 under
  // institutions/{institutionId}/parent-chat/.
  attachmentUrl   String?
  attachmentType  String?
  attachmentName  String?
  readAt          DateTime?
  hiddenAt        DateTime?
  hiddenByUserId  String?
  reportedAt      DateTime?
  reportedByUserId String?
  reportReason    String?
  createdAt       DateTime         @default(now())
  thread          ParentChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@index([institutionId])
  @@index([institutionId, reportedAt])
}

// ── Parent forms: permission slips & polls ───────────────────────────────────
// Created by a class teacher (for their own division(s)) or an admin (any
// divisions / the whole school). Answered by the parent from Parent Mode, which
// lives inside the student's own login — so a response belongs to a student.

model ParentForm {
  id              String               @id @default(uuid())
  institutionId   String
  kind            String               // "SLIP" (Yes/No consent) | "POLL" (single choice)
  title           String
  description     String?
  // Answer choices. A slip is always ["Yes", "No"]; a poll has 2-6 custom ones.
  options         Json
  allowComment    Boolean              @default(true)
  deadline        DateTime?
  closedAt        DateTime?
  // Set when the automatic ~24h-before-deadline reminder went out (sent once).
  reminderSentAt  DateTime?
  // Last time any reminder (manual or automatic) was sent; throttles the manual button.
  lastRemindedAt  DateTime?
  allDivisions    Boolean              @default(false)
  createdByUserId String
  createdByRole   String               // "ADMIN" | "TEACHER"
  createdAt       DateTime             @default(now())
  targets         ParentFormTarget[]
  responses       ParentFormResponse[]

  @@index([institutionId, createdAt])
  @@index([institutionId, createdByUserId])
}

model ParentFormTarget {
  id            String     @id @default(uuid())
  institutionId String
  formId        String
  divisionId    String
  form          ParentForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  division      Division   @relation(fields: [divisionId], references: [id], onDelete: Cascade)

  @@unique([formId, divisionId])
  @@index([divisionId])
}

model ParentFormResponse {
  id            String     @id @default(uuid())
  institutionId String
  formId        String
  studentId     String
  optionIndex   Int
  comment       String?
  // Every answer given, oldest first: [{ optionIndex, comment, at }]. Parents can
  // change their answer until the deadline; this is the audit trail.
  history       Json
  respondedAt   DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  form          ParentForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  student       Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([formId, studentId])
  @@index([studentId])
}

// ── Parent-teacher meeting scheduler ─────────────────────────────────────────
// A teacher publishes a session (date + time window + slot length); slots are
// generated up front and a parent books one slot per session from Parent Mode.

model PtmSession {
  id            String    @id @default(uuid())
  institutionId String
  teacherId     String
  title         String
  date          DateTime  @db.Date
  startMinute   Int       // minutes after midnight, IST
  endMinute     Int
  slotMinutes   Int
  location      String?
  note          String?
  cancelledAt   DateTime?
  createdAt     DateTime  @default(now())
  teacher       Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  slots         PtmSlot[]

  @@index([institutionId, date])
  @@index([teacherId, date])
}

model PtmSlot {
  id             String     @id @default(uuid())
  institutionId  String
  sessionId      String
  startMinute    Int
  endMinute      Int
  studentId      String?
  bookedByUserId String?
  bookedAt       DateTime?
  session        PtmSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student        Student?   @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@unique([sessionId, startMinute])
  // One booking per student per session (nulls don't collide in Postgres).
  @@unique([sessionId, studentId])
  @@index([studentId])
}
