generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
}

enum InstitutionType {
  SCHOOL
  COLLEGE
  COACHING
}

enum InstitutionStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAUSED
  EXPIRED
  LOCKED
}

enum PaymentStatus {
  PAID
  PENDING
  FAILED
}

// ─── Models ───────────────────────────────────────────────────────────────────

model Institution {
  id              String            @id @default(uuid())
  institutionCode String            @unique // e.g. QX-SCH-2026-0001
  name            String
  email           String            @unique
  type            InstitutionType
  status          InstitutionStatus @default(PENDING)

  // Contact & Location
  phone   String?
  city    String?
  state   String?
  address String?
  pincode String?
  country String? @default("India")

  // Academic Info
  board   String?
  medium  String?
  logoUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  subscription  Subscription?
  bills         Bill[]
  invites       Invite[]
  auditLogs     AuditLog[]
  notifications NotificationRecipient[]
  tickets       SupportTicket[]
  reviews       Review[]
}

model User {
  id       String  @id @default(uuid())
  name     String?
  email    String  @unique
  password String?
  role     Role
  isActive Boolean @default(false)

  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs AuditLog[]
}

enum TrialOutcome {
  EXTENDED
  ACTIVATED
  CHURNED
}

model Plan {
  id              String @id @default(uuid())
  name            String @unique
  basePrice       Float
  perStudentPrice Float

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]
}

model Subscription {
  id String @id @default(uuid())

  institutionId String      @unique
  institution   Institution @relation(fields: [institutionId], references: [id])

  planId String
  plan   Plan   @relation(fields: [planId], references: [id])

  // Trial tracking
  trialDays           Int?          // number of trial days set by superadmin
  trialOutcome        TrialOutcome? // what happened after trial ended
  trialWarningSent    Boolean       @default(false)
  trialExpiryNotified Boolean       @default(false)

  status        SubscriptionStatus @default(TRIAL)
  paymentStatus PaymentStatus      @default(PENDING)
  discount      Float              @default(0)
  features      Json?

  activationDate  DateTime? // billing anchor — set when plan transitions from TRIAL to ACTIVE
  pausedAt        DateTime?
  pauseMonthsUsed Int       @default(0)
  addons          Json?

  startDate DateTime
  endDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Bill {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])

  type         String
  billingMonth String?

  userCount      Int   @default(0)
  baseAmount     Float @default(0)
  addonAmount    Float @default(0)
  discountAmount Float @default(0)
  totalAmount    Float

  status PaymentStatus @default(PENDING)
  items  Json // BillItem[]

  generatedAt DateTime  @default(now())
  dueDate     DateTime?
  paidAt      DateTime?
}

model Invite {
  id String @id @default(uuid())

  email     String
  tokenHash String @unique
  role      Role

  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])

  expiresAt DateTime
  isUsed    Boolean  @default(false)

  createdAt DateTime @default(now())
}

model AuditLog {
  id            String  @id @default(uuid())
  action        String
  userId        String?
  actorRole     String?
  institutionId String?
  details       String?
  ip            String?
  metadata      Json?

  user        User?        @relation(fields: [userId], references: [id])
  institution Institution? @relation(fields: [institutionId], references: [id])

  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([action])
  @@index([actorRole])
  @@index([institutionId])
}

model Notification {
  id            String  @id @default(uuid())
  title         String
  message       String
  tag           String
  recipientType String
  deliveredTo   Int     @default(0)
  sentById      String?

  recipients NotificationRecipient[]

  createdAt DateTime @default(now())
}

model NotificationRecipient {
  id             String       @id @default(uuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id])
  institutionId  String
  institution    Institution  @relation(fields: [institutionId], references: [id])
}

model SupportTicket {
  id          String @id @default(uuid())
  title       String
  description String
  category    String
  priority    String
  status      String @default("OPEN")

  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  adminEmail    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  replies TicketReply[]
}

model TicketReply {
  id       String        @id @default(uuid())
  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id])

  author  String
  role    String
  message String

  createdAt DateTime @default(now())
}

model Review {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])

  adminName    String
  adminEmail   String
  rating       Int
  title        String
  body         String
  likes        Int     @default(0)
  replyMessage String?

  repliedAt DateTime?
  createdAt DateTime  @default(now())
}
