// ── Payroll ─────────────────────────────────────────────────────────────────
// All money is stored as integer PAISE (₹1 = 100) — never Float — so salary
// maths never picks up floating-point rounding errors.

// One row per institution. How a day's salary is worked out for LOP /
// mid-month joiners, and which day salary is normally paid.
model PayrollSettings {
  id            String @id @default(uuid())
  institutionId String @unique
  dayBasis      String @default("CALENDAR") // CALENDAR (actual days in month) | FIXED_30 | FIXED_26
  payDay        Int    @default(1) // day of month salary is usually paid (1-28)

  // Provident Fund. Rates in basis points (1200 = 12%), ceiling in paise.
  pfEnabled      Boolean @default(false)
  pfCeiling      Int     @default(2500000) // ₹25,000 monthly wage ceiling (EPFO, from 17 Sep 2026)
  pfCapWages     Boolean @default(true) // PF on wages up to the ceiling (false = on full PF wages)
  pfEmployeeRate Int     @default(1200)
  pfEmployerRate Int     @default(1200) // EPS + EPF together
  pfEpsRate      Int     @default(833) // pension part, always on wages up to the ceiling
  pfEdliRate     Int     @default(50)
  pfAdminRate    Int     @default(50)

  // ESI. Rates in basis points (75 = 0.75%), limit in paise.
  esiEnabled      Boolean @default(false)
  esiWageLimit    Int     @default(2100000) // ₹21,000 normal monthly gross
  esiEmployeeRate Int     @default(75)
  esiEmployerRate Int     @default(325)

  // Professional Tax (state-wise slab table).
  ptEnabled Boolean @default(false)
  ptState   String? // e.g. "MAHARASHTRA" (preset) or "CUSTOM"
  ptSlabs   Json? // [{ from, amount, febAmount? }] in paise

  // Income tax deducted at source on salary (section 192), worked out monthly.
  tdsEnabled Boolean @default(false)

  // Staff attendance -> LOP. When on, a draft run takes each person's LOP days
  // from staff attendance (absent + unpaid leave + half days [+ late rule]).
  attendanceLop   Boolean @default(false)
  officeStart     String  @default("08:00") // HH:MM, check-in after start + grace = Late
  graceMinutes    Int     @default(10)
  halfDayMinutes  Int     @default(240) // worked less than this (check-in to check-out) = Half day
  weeklyOffDays   Json? // weekdays off, 0 = Sunday ... 6 = Saturday. Default [0]
  offSaturdays    Json? // which Saturdays of the month are off, e.g. [2, 4]
  lateRuleEnabled Boolean @default(false) // every N lates = half day LOP
  lateRuleCount   Int     @default(3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One row per staff member per day. Status comes from machine punches (IMPORT /
// DEVICE) or is marked by hand (MANUAL). A manual mark is never overwritten by a
// later import.
model StaffAttendance {
  id            String   @id @default(uuid())
  institutionId String
  staffId       String
  staff         Staff    @relation(fields: [staffId], references: [id])
  date          String // YYYY-MM-DD
  status        String // PRESENT | LATE | HALF_DAY | ABSENT | PAID_LEAVE | UNPAID_LEAVE
  checkIn       String? // HH:MM
  checkOut      String? // HH:MM
  source        String   @default("MANUAL") // MANUAL | IMPORT | DEVICE
  note          String?
  markedById    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([staffId, date])
  @@index([institutionId, date])
}

// Raw punches from an attendance machine (imported file or, later, device push).
// Kept so re-importing the same file adds nothing, and unknown machine IDs can be
// matched to staff later.
model StaffPunch {
  id            String   @id @default(uuid())
  institutionId String
  machineId     String
  date          String // YYYY-MM-DD
  time          String // HH:MM:SS
  source        String   @default("IMPORT") // IMPORT | DEVICE
  createdAt     DateTime @default(now())

  @@unique([institutionId, machineId, date, time])
  @@index([institutionId, date])
}

// The institution's own catalog of salary heads (Basic, HRA, DA, PT...).
// Staff structures / templates pick from this list and give each a value.
model SalaryComponent {
  id            String  @id @default(uuid())
  institutionId String
  name          String
  type          String // EARNING | DEDUCTION
  calcType      String  @default("FIXED") // FIXED (value = paise) | PERCENT_OF_BASIC (value = basis points, 4000 = 40%)
  isBasic       Boolean @default(false) // the one EARNING that PERCENT_OF_BASIC components are calculated from
  lopApplicable Boolean @default(true) // reduced for loss-of-pay days / partial months
  pfApplicable  Boolean @default(false) // counts towards PF wages (Basic always does; usually also DA)
  defaultValue  Int     @default(0) // pre-filled value when added to a structure/template
  sortOrder     Int     @default(0)
  isActive      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([institutionId, name])
  @@index([institutionId])
}

model SalaryTemplate {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  name          String
  items         Json // [{ componentId, value }] — value in paise (FIXED) or basis points (PERCENT_OF_BASIC)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([institutionId, name])
  @@index([institutionId])
}

model Staff {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])

  name           String
  email          String? // optional for payroll-only staff (peon/driver without email) - no payslip email then
  phone          String?
  designation    String?
  staffType      String // TEACHER | ADMIN | SUB_ADMIN | HELPER | OTHER
  status         String    @default("ACTIVE") // ACTIVE | INACTIVE
  joinedAt       DateTime? // actual SCHOOL joining date, only filled for new joiners. Null = already on staff -> full salary
  exitDate       DateTime? // last working day, set when someone leaves
  employeeCode   String?
  pan            String?
  uan            String? // PF Universal Account Number
  paymentMode    String    @default("BANK") // BANK | CASH | CHEQUE
  pfApplicable   Boolean   @default(true) // PF is deducted for this person when the school has PF on
  epsApplicable  Boolean   @default(true) // false: no EPS (pension), e.g. age 58+ — full employer 12% goes to EPF
  esiApplicable  Boolean   @default(true) // ESI applies (when the school has ESI on and gross is within the limit)
  esiNumber      String? // ESIC insurance (IP) number
  ptApplicable   Boolean   @default(true) // Professional Tax applies (turn off for exempt staff)
  tdsApplicable  Boolean   @default(true) // TDS worked out for this person when the school has TDS on
  taxRegime      String    @default("NEW") // NEW | OLD
  taxDeclaration Json? // { sec80C, sec80D, hraExempt, otherDeductions, prevEmployerIncome, prevEmployerTds } in paise
  bankDetails    String? // AES-GCM encrypted JSON {accountName, accountNumber, ifsc, bankName} (fieldEncryption.service)
  sortOrder      Int       @default(0) // admin-chosen list order (drag to reorder); new staff go to the end
  machineId      String? // this person's ID on the school's fingerprint / RFID attendance machine

  userId String? @unique // optional link to an existing Teacher/Admin/Sub-Admin User. Null = payroll-only staff.
  user   User?   @relation(fields: [userId], references: [id])

  salaryStructures StaffSalaryStructure[]
  payslips         Payslip[]
  attendance       StaffAttendance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([institutionId])
}

// Versioned — a raise adds a NEW row with a later effectiveFrom instead of
// overwriting, so salary history is kept. The structure in force for a month
// is the latest row whose effectiveFrom is on/before that month's last day.
model StaffSalaryStructure {
  id            String      @id @default(uuid())
  staffId       String
  staff         Staff       @relation(fields: [staffId], references: [id])
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  templateId    String?
  items         Json // [{ componentId, value }] — value in paise (FIXED) or basis points (PERCENT_OF_BASIC)
  effectiveFrom DateTime
  note          String? // e.g. "Annual increment 2026"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([institutionId])
  @@index([staffId, effectiveFrom])
}

model PayrollRun {
  id                String      @id @default(uuid())
  institutionId     String
  institution       Institution @relation(fields: [institutionId], references: [id])
  month             String // "2026-10"
  // DRAFT -> PENDING_APPROVAL (accountant sends) -> APPROVED (admin) -> PUBLISHED.
  // Admin can send back to DRAFT with a note; admin may also publish directly.
  status            String      @default("DRAFT") // DRAFT | PENDING_APPROVAL | APPROVED | PUBLISHED
  // Set when someone has gone through the LOP / bonus grid (saved it, or
  // confirmed "nothing to add"). Needed before sending for approval / publishing.
  inputsCheckedAt   DateTime?
  inputsCheckedById String?
  submittedAt       DateTime?
  submittedById     String?
  approvedAt        DateTime?
  approvedById      String?
  reviewNote        String? // admin's note when sending the run back
  reviewNoteAt      DateTime?
  publishedAt       DateTime?
  publishedBy       String?

  // Background publish (PDFs + emails run on the server, page can be closed).
  publishState       String? // null | RUNNING | FAILED
  publishTotal       Int       @default(0)
  publishDone        Int       @default(0)
  publishError       String?
  publishStartedAt   DateTime?
  publishHeartbeatAt DateTime? // updated after every payslip; a stale one means the server restarted mid-way

  // Last "AI review" of this payroll (on demand). aiReviewHash = fingerprint of
  // the payslip numbers it looked at, so the UI can say when it's out of date.
  aiReview     Json?
  aiReviewAt   DateTime?
  aiReviewHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payslips Payslip[]

  @@unique([institutionId, month])
  @@index([institutionId])
}

model Payslip {
  id            String      @id @default(uuid())
  payrollRunId  String
  payrollRun    PayrollRun  @relation(fields: [payrollRunId], references: [id])
  staffId       String
  staff         Staff       @relation(fields: [staffId], references: [id])
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])

  // Snapshotted at run-creation time — a payroll-only Staff row has no live
  // profile to join against later, and a published payslip must keep the
  // name/email it was actually generated for even if the Staff row changes.
  staffName  String
  staffEmail String?

  earnings   Json // [{ label, amount }] — amount in paise
  deductions Json // [{ label, amount }] — amount in paise
  grossPay   Int // paise
  netPay     Int // paise

  // Attendance-driven inputs/results for the month.
  lopDays           Float   @default(0) // loss-of-pay days entered for this month (half days allowed)
  lopSource         String? // ATTENDANCE (taken from staff attendance, refreshed while draft) | MANUAL (typed in the grid)
  attendanceSummary Json? // { absent, halfDay, unpaidLeave, late, unmarked, workingDays } behind the ATTENDANCE LOP
  paidDays          Float   @default(0) // days actually paid after LOP + joining/exit proration
  basisDays         Int     @default(0) // day count one day's salary was based on (per PayrollSettings.dayBasis)

  // Monthly inputs entered in the LOP / bonus grid (draft only), in paise.
  bonus          Int     @default(0)
  otherDeduction Int     @default(0)
  inputNote      String? // e.g. "Diwali bonus", "Advance recovery"

  // Employer contributions (PF etc.) - school's cost, not deducted. [{ label, amount }] in paise.
  employerContributions Json?
  pfWages               Int   @default(0) // PF wages earned this month (paise), for the EPFO ECR file
  tdsInfo               Json? // how this month's TDS was worked out (estimated yearly income, tax, months left...); {} when no TDS

  status        String    @default("PENDING") // PENDING | PAID
  paidAt        DateTime?
  paymentMethod String?
  paymentRef    String?
  pdfUrl        String?
  notifiedAt    DateTime? // payslip email + in-app notification sent (so a retried publish never sends twice)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([payrollRunId, staffId])
  @@index([institutionId])
  @@index([staffId])
}

