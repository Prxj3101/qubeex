  issuedToName String @default("")
  issuedToLabel String @default("")
  dueOn DateTime? @db.Date
  returnExpected Boolean @default(false)
  issueId String?
  issue InventoryStockMovement? @relation("InventoryReturns", fields: [issueId], references: [id], onDelete: Restrict)
  returns InventoryStockMovement[] @relation("InventoryReturns")
  @@index([issueId])
  attachments Json @default("[]")
  corrections Json @default("[]")
  id String @id @default(uuid())
