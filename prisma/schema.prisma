generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Institution {
  inventorySetupOrders InventorySetupOrder[]
  inventoryPurchaseOrders InventoryPurchaseOrder[]
  inventoryPurchaseRequests InventoryPurchaseRequest[]
  id                               String                            @id @default(uuid())
  institutionCode                  String                            @unique
  name                             String
  email                            String                            @unique
  type                             InstitutionType
  status                           InstitutionStatus                 @default(PENDING)
  phone                            String?
  city                             String?
  state                            String?
  address                          String?
  pincode                          String?
  country                          String?                           @default("India")
  board                            String?
  medium                           String?
  logoUrl                          String?
  createdAt                        DateTime                          @default(now())
  updatedAt                        DateTime                          @updatedAt
  adminDob                         String?
  adminGender                      String?
  adminPhone                       String?
  adminPrefix                      String?
  adminTitle                       String?
  establishedOn                    String?
  adminAvatarUrl                   String?
  nextAdminSeq                     Int                               @default(0)
  nextStudentSeq                   Int                               @default(0)
  nextTeacherSeq                   Int                               @default(0)
  userIdDisambiguator              String?
  userIdPrefix                     String?
  isDemo                           Boolean                           @default(false)
  themeColor                       String                            @default("purple")
  inventoryItems InventoryItem[]
  inventoryStockBalances InventoryStockBalance[]
  inventoryStockMovements InventoryStockMovement[]
  inventorySuppliers               InventorySupplier[]
  inventoryLocations               InventoryLocation[]
  inventoryCategories              InventoryCategory[]
  inventoryUnits                   InventoryUnit[]
  adminNotes                       AdminNote[]
  adminTasks                       AdminTask[]
  aiUsageEvents                    AiUsageEvent[]
  attendances                      Attendance[]
  attendanceDayNotes               AttendanceDayNote[]
  auditLogs                        AuditLog[]
  bills                            Bill[]
  blackboardFolders                BlackboardFolder[]
  blackboardMaterials              BlackboardMaterial[]
  calendarEvents                   CalendarEvent[]
  campusPosts                      CampusFeedPost[]
  divisions                        Division[]
  assignments                      DivisionAssignment[]
  feeStructures                    DivisionFeeStructure[]
  dbConfig                         InstitutionDbConfig?
  invites                          Invite[]
  marksheets                       Marksheet[]
  mindmaps                         Mindmap[]
  notifications                    NotificationRecipient[]
  ptmNotes                         PTMNote[]
  payrollRuns                      PayrollRun[]
  payslips                         Payslip[]
  promotionBatches                 PromotionBatch[]
  questionShareTokens              QuestionShareToken[]
  reviews                          Review[]
  salaryTemplates                  SalaryTemplate[]
  holidays                         SchoolHoliday[]
  staff                            Staff[]
  staffPosts                       StaffPost[]
  staffSalaryStructures            StaffSalaryStructure[]
  standards                        Standard[]
  students                         Student[]
  studentFeePayments               StudentFeePayment[]
  studentPromotionOutcomes         StudentPromotionOutcome[]
  studentRemarks                   StudentRemark[]
  subAdmins                        SubAdmin[]
  subjects                         Subject[]
  subscription                     Subscription?
  tickets                          SupportTicket[]
  taskAssignments                  TaskAssignment[]
  taskAssignmentSubmissions        TaskAssignmentSubmission[]
  taskAssignmentSubmissionAttempts TaskAssignmentSubmissionAttempt[]
  taskContainers                   TaskContainer[]
  taskModules                      TaskModule[]
  taskPdfUploads                   TaskPdfUpload[]
  taskQuestions                    TaskQuestion[]
  taskTests                        TaskTest[]
  teachers                         Teacher[]
  teacherNotes                     TeacherNote[]
  teacherTasks                     TeacherTask[]
  users                            User[]
  whiteLabelConfig                 WhiteLabelConfig?
  academicYears                    AcademicYear[]
  studentEnrollments               StudentEnrollment[]
  divisionTimetables               DivisionTimetable[]
  timetableSettings                TimetableSettings[]
  timeSlots                        TimeSlot[]
  timetableSessionTypes            TimetableSessionType[]
  rooms                            Room[]
  roomUnavailability               RoomUnavailability[]
  teacherAvailability              TeacherAvailability[]
  teacherTimetablePrefs            TeacherTimetablePref[]
  schoolTimetables                 SchoolTimetable[]
  timetableSubjectConfigs          TimetableSubjectConfig[]
  timetableEntries                 TimetableEntry[]
  timetableExceptions              TimetableException[]
  timetableSubstitutions           TimetableSubstitution[]
  timetableGenerations             TimetableGeneration[]
}

model User {
  id                     String                  @id @default(uuid())
  name                   String?
  email                  String                  @unique
  password               String?
  role                   Role
  isActive               Boolean                 @default(false)
  institutionId          String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  mustChangePassword     Boolean                 @default(false)
  displayId              String?
  adminNotes             AdminNote[]
  adminTasks             AdminTask[]
  aiChatMessages         AiChatMessage[]
  aiUsageEvents          AiUsageEvent[]
  auditLogs              AuditLog[]
  calendarEventsCreated  CalendarEvent[]         @relation("CalendarEventCreator")
  campusPostsAuthored    CampusFeedPost[]        @relation("CampusFeedPostAuthor")
  NotificationRecipient  NotificationRecipient[]
  ptmNotesCreated        PTMNote[]               @relation("PTMNoteCreator")
  staff                  Staff?
  staffMessagesReceived  StaffMessage[]          @relation("StaffMessageReceiver")
  staffMessagesSent      StaffMessage[]          @relation("StaffMessageSender")
  staffPostsAuthored     StaffPost[]             @relation("StaffPostAuthor")
  staffCommentsAuthored  StaffPostComment[]      @relation("StaffPostCommentAuthor")
  staffReactions         StaffPostReaction[]     @relation("StaffPostReactionUser")
  student                Student?
  studentRemarksAssigned StudentRemark[]         @relation("StudentRemarkAssignee")
  studentRemarksReported StudentRemark[]         @relation("StudentRemarkReporter")
  studentRemarksReviewed StudentRemark[]         @relation("StudentRemarkReviewer")
  subAdmin               SubAdmin?
  teacher                Teacher?
  institution            Institution?            @relation(fields: [institutionId], references: [id])
  statusEvents           UserStatusEvent[]
  pushTokens             PushToken[]
}

// Expo push tokens — one per device, so a user with multiple devices gets a
// push on all of them. Keyed unique on `token` (not userId) so re-registering
// the same device after a re-login on a different account reassigns it
// instead of leaving a duplicate row pointed at the old user.
model PushToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Plan {
  id              String         @id @default(uuid())
  name            String         @unique
  basePrice       Float
  perStudentPrice Float
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  subscriptions   Subscription[]
}

model Subscription {
  id                  String             @id @default(uuid())
  institutionId       String             @unique
  planId              String
  trialDays           Int?
  trialOutcome        TrialOutcome?
  trialWarningSent    Boolean            @default(false)
  trialExpiryNotified Boolean            @default(false)
  status              SubscriptionStatus @default(TRIAL)
  paymentStatus       PaymentStatus      @default(PENDING)
  discount            Float              @default(0)
  features            Json?
  activationDate      DateTime?
  pausedAt            DateTime?
  pauseMonthsUsed     Int                @default(0)
  addons              Json?
  startDate           DateTime?
  endDate             DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  commitmentEndDate   DateTime?
  planOption          PlanOption         @default(NORMAL)
  lastResumedAt       DateTime?
  institution         Institution        @relation(fields: [institutionId], references: [id])
  plan                Plan               @relation(fields: [planId], references: [id])
}

model Bill {
  id                String        @id @default(uuid())
  institutionId     String
  type              String
  billingMonth      String?
  userCount         Int           @default(0)
  baseAmount        Float         @default(0)
  addonAmount       Float         @default(0)
  discountAmount    Float         @default(0)
  totalAmount       Float
  status            PaymentStatus @default(PENDING)
  items             Json
  generatedAt       DateTime      @default(now())
  dueDate           DateTime?
  paidAt            DateTime?
  razorpayLinkId    String?
  razorpayLinkUrl   String?
  razorpayPaymentId String?
  paymentMethod     String?
  institution       Institution   @relation(fields: [institutionId], references: [id])
}

model Invite {
  id            String      @id @default(uuid())
  email         String
  tokenHash     String      @unique
  role          Role
  institutionId String
  expiresAt     DateTime
  isUsed        Boolean     @default(false)
  createdAt     DateTime    @default(now())
  permissions   String[]    @default([])
  institution   Institution @relation(fields: [institutionId], references: [id])
}

model Teacher {
  id                    String                   @id @default(uuid())
  teacherId             String
  userId                String                   @unique
  institutionId         String
  phone                 String?
  avatarUrl             String?
  dob                   String?
  gender                String?
  address               String?
  city                  String?
  state                 String?
  pincode               String?
  country               String?                  @default("India")
  qualification         String?
  experience            String?
  status                TeacherStatus            @default(ACTIVE)
  joinedAt              DateTime                 @default(now())
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  prefix                String?
  title                 String?                  @default("Teacher")
  aiSoftLimitTokens     Int?
  blackboardFolders     BlackboardFolder[]
  blackboardMaterials   BlackboardMaterial[]
  classDivisions        Division[]               @relation("ClassTeacherDivisions")
  assignments           DivisionAssignment[]
  createdMarksheets     Marksheet[]              @relation("MarksheetCreator")
  mindmaps              Mindmap[]
  parentChatThreads     ParentChatThread[]
  ptmSessions           PtmSession[]
  questionShareTokens   QuestionShareToken[]
  taskAssignments       TaskAssignment[]
  taskContainers        TaskContainer[]
  taskModules           TaskModule[]
  taskPdfUploads        TaskPdfUpload[]
  taskQuestions         TaskQuestion[]
  taskTests             TaskTest[]
  institution           Institution              @relation(fields: [institutionId], references: [id])
  user                  User                     @relation(fields: [userId], references: [id])
  teacherNotes          TeacherNote[]
  teacherTasks          TeacherTask[]
  timetableAvailability TeacherAvailability[]
  timetablePrefs        TeacherTimetablePref[]
  timetableConfigs      TimetableSubjectConfig[]
  timetableEntries      TimetableEntry[]
  timetableExceptions   TimetableException[]
  substitutions         TimetableSubstitution[]  @relation("SubstituteTeacher")

  @@unique([teacherId, institutionId])
  @@index([institutionId])
}

model TeacherNote {
  id            String      @id @default(uuid())
  teacherId     String
  institutionId String
  text          String
  color         String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  institution   Institution @relation(fields: [institutionId], references: [id])
  teacher       Teacher     @relation(fields: [teacherId], references: [id])

  @@index([teacherId])
}

model TeacherTask {
  id            String      @id @default(uuid())
  teacherId     String
  institutionId String
  text          String
  done          Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  institution   Institution @relation(fields: [institutionId], references: [id])
  teacher       Teacher     @relation(fields: [teacherId], references: [id])

  @@index([teacherId])
}

model AdminNote {
  id            String      @id @default(uuid())
  userId        String
  institutionId String
  text          String
  color         String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  institution   Institution @relation(fields: [institutionId], references: [id])
  user          User        @relation(fields: [userId], references: [id])

  @@index([userId])
}

model AdminTask {
  id            String      @id @default(uuid())
  userId        String
  institutionId String
  text          String
  done          Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  dueAt         DateTime?
  institution   Institution @relation(fields: [institutionId], references: [id])
  user          User        @relation(fields: [userId], references: [id])

  @@index([userId])
}

model SubAdmin {
  id            String      @id @default(uuid())
  userId        String      @unique
  institutionId String
  permissions   String[]
  createdById   String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  designation   String?
  phone         String?
  dob           String?
  gender        String?
  address       String?
  city          String?
  state         String?
  pincode       String?
  country       String?     @default("India")
  qualification String?
  experience    String?
  avatarUrl     String?
  prefix        String?
  institution   Institution @relation(fields: [institutionId], references: [id])
  user          User        @relation(fields: [userId], references: [id])

  @@index([institutionId])
}

model AuditLog {
  id            String        @id @default(uuid())
  action        String
  userId        String?
  actorRole     String?
  institutionId String?
  details       String?
  ip            String?
  metadata      Json?
  createdAt     DateTime      @default(now())
  category      AuditCategory @default(ADMIN_ACTION)
  severity      AuditSeverity @default(INFO)
  institution   Institution?  @relation(fields: [institutionId], references: [id])
  user          User?         @relation(fields: [userId], references: [id])

  @@index([institutionId, category, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([action])
  @@index([actorRole])
  @@index([institutionId])
}

model UserStatusEvent {
  id            String   @id @default(uuid())
  userId        String
  institutionId String?
  isActive      Boolean
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([institutionId])
}

model Notification {
  id            String                  @id @default(uuid())
  title         String
  message       String
  tag           String
  recipientType String
  deliveredTo   Int                     @default(0)
  sentById      String?
  createdAt     DateTime                @default(now())
  recipients    NotificationRecipient[]
}

model NotificationRecipient {
  id             String       @id @default(uuid())
  notificationId String
  institutionId  String
  dismissedAt    DateTime?
  readAt         DateTime?
  userId         String?
  institution    Institution  @relation(fields: [institutionId], references: [id])
  notification   Notification @relation(fields: [notificationId], references: [id])
  User           User?        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([institutionId, readAt])
  @@index([institutionId, dismissedAt])
  @@index([institutionId, userId])
}

model SupportTicket {
  id            String        @id @default(uuid())
  title         String
  description   String
  category      String
  priority      String
  status        String        @default("OPEN")
  institutionId String
  adminEmail    String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  attachments   Json?
  institution   Institution   @relation(fields: [institutionId], references: [id])
  replies       TicketReply[]
}

model DemoRequest {
  id              String            @id @default(uuid())
  name            String
  email           String
  phone           String
  institutionName String
  institutionType InstitutionType
  studentCount    Int?
  message         String?
  status          DemoRequestStatus @default(NEW)
  emailSent       Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([email, createdAt])
}

model TicketReply {
  id          String        @id @default(uuid())
  ticketId    String
  author      String
  role        String
  message     String
  createdAt   DateTime      @default(now())
  attachments Json?
  ticket      SupportTicket @relation(fields: [ticketId], references: [id])
}

model Review {
  id            String      @id @default(uuid())
  institutionId String
  adminName     String
  adminEmail    String
  rating        Int
  title         String
  body          String
  likes         Int         @default(0)
  replyMessage  String?
  repliedAt     DateTime?
  createdAt     DateTime    @default(now())
  institution   Institution @relation(fields: [institutionId], references: [id])
}

model Standard {
  id            String              @id @default(uuid())
  institutionId String
  name          String
  order         Int
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  divisions     Division[]
  institution   Institution         @relation(fields: [institutionId], references: [id])
  students      Student[]
  subjects      Subject[]
  enrollments   StudentEnrollment[]

  @@unique([institutionId, name])
  @@index([institutionId])
}

model Division {
  id                  String                   @id @default(uuid())
  standardId          String
  institutionId       String
  name                String
  capacity            Int?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  classTeacherId      String?
  timetableUrl        String?
  attendances         Attendance[]
  attendanceDayNotes  AttendanceDayNote[]
  parentFormTargets   ParentFormTarget[]
  calendarEvents      CalendarEvent[]
  campusPosts         CampusFeedPost[]
  classTeacher        Teacher?                 @relation("ClassTeacherDivisions", fields: [classTeacherId], references: [id])
  institution         Institution              @relation(fields: [institutionId], references: [id])
  standard            Standard                 @relation(fields: [standardId], references: [id])
  assignments         DivisionAssignment[]
  feeStructures       DivisionFeeStructure[]
  divisionSubjects    DivisionSubject[]
  marksheets          Marksheet[]
  students            Student[]
  taskAssignments     TaskAssignment[]
  taskContainers      TaskContainer[]
  taskTests           TaskTest[]
  enrollments         StudentEnrollment[]
  timetables          DivisionTimetable[]
  schoolTimetables    SchoolTimetable[]
  timetableConfigs    TimetableSubjectConfig[]
  timetableEntries    TimetableEntry[]
  timetableExceptions TimetableException[]

  @@unique([standardId, name])
  @@index([institutionId])
  @@index([standardId])
}

model Subject {
  id                  String                   @id @default(uuid())
  institutionId       String
  name                String
  code                String?
  color               String?
  order               Int
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  standardId          String
  campusFeedPosts     CampusFeedPost[]
  assignments         DivisionAssignment[]
  divisionSubjects    DivisionSubject[]
  marksheetColumns    MarksheetExamColumn[]
  marksheetConfigs    MarksheetSubjectConfig[]
  institution         Institution              @relation(fields: [institutionId], references: [id])
  timetableConfigs    TimetableSubjectConfig[]
  timetableEntries    TimetableEntry[]
  timetableExceptions TimetableException[]
  standard            Standard                 @relation(fields: [standardId], references: [id])
  taskAssignments     TaskAssignment[]
  taskContainers      TaskContainer[]
  taskModules         TaskModule[]
  taskQuestions       TaskQuestion[]
  taskTests           TaskTest[]

  @@unique([standardId, name])
  @@index([standardId])
  @@index([institutionId])
}

model DivisionSubject {
  id            String   @id @default(uuid())
  divisionId    String
  subjectId     String
  institutionId String
  division      Division @relation(fields: [divisionId], references: [id])
  subject       Subject  @relation(fields: [subjectId], references: [id])

  @@unique([divisionId, subjectId])
  @@index([divisionId])
}

model DivisionAssignment {
  id             String       @id @default(uuid())
  divisionId     String
  subjectId      String?
  teacherId      String
  institutionId  String
  academicYearId String
  createdAt      DateTime     @default(now())
  division       Division     @relation(fields: [divisionId], references: [id])
  institution    Institution  @relation(fields: [institutionId], references: [id])
  subject        Subject?     @relation(fields: [subjectId], references: [id])
  teacher        Teacher      @relation(fields: [teacherId], references: [id])
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])

  @@unique([divisionId, subjectId, teacherId, academicYearId])
  @@index([divisionId])
  @@index([teacherId])
  @@index([institutionId])
  @@index([academicYearId])
}

model Student {
  id                               String                            @id @default(uuid())
  studentId                        String
  userId                           String                            @unique
  institutionId                    String
  standardId                       String?
  divisionId                       String?
  phone                            String?
  avatarUrl                        String?
  dob                              String?
  gender                           String?
  address                          String?
  city                             String?
  state                            String?
  pincode                          String?
  country                          String?                           @default("India")
  status                           StudentStatus                     @default(ACTIVE)
  joinedAt                         DateTime                          @default(now())
  createdAt                        DateTime                          @default(now())
  updatedAt                        DateTime                          @updatedAt
  aadharNo                         String?
  bloodGroup                       String?
  category                         String?
  emergencyContact                 String?
  guardians                        Json?
  houseColor                       String?
  panNo                            String?
  religion                         String?
  rollNo                           String?
  tempPassword                     String?
  admissionYear                    String?
  nationality                      String?
  hasLoggedIn                      Boolean                           @default(false)
  extraDetailFields                Json?
  attendances                      Attendance[]
  marksheetGradedScores            MarksheetGradedScore[]
  marksheetRemarks                 MarksheetRemark[]
  marksheetScores                  MarksheetScore[]
  ptmNotes                         PTMNote[]
  parentModeEvents                 ParentModeEvent[]
  parentChatThreads                ParentChatThread[]
  parentFormResponses              ParentFormResponse[]
  ptmSlots                         PtmSlot[]
  division                         Division?                         @relation(fields: [divisionId], references: [id])
  institution                      Institution                       @relation(fields: [institutionId], references: [id])
  standard                         Standard?                         @relation(fields: [standardId], references: [id])
  user                             User                              @relation(fields: [userId], references: [id])
  feePayments                      StudentFeePayment[]
  promotionOutcomes                StudentPromotionOutcome[]
  remarks                          StudentRemark[]
  taskAssignmentSubmissions        TaskAssignmentSubmission[]
  taskAssignmentSubmissionAttempts TaskAssignmentSubmissionAttempt[]
  taskTestAttempts                 TaskTestAttempt[]
  enrollments                      StudentEnrollment[]

  @@unique([studentId, institutionId])
  @@index([institutionId])
}

model ParentModeEvent {
  id            String   @id @default(uuid())
  studentId     String
  institutionId String
  openedAt      DateTime @default(now())
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([institutionId, openedAt])
  @@index([studentId, openedAt])
}

enum AcademicYearStatus {
  ACTIVE
  CLOSED
}

model AcademicYear {
  id            String             @id @default(uuid())
  institutionId String
  institution   Institution        @relation(fields: [institutionId], references: [id])
  label         String
  startDate     DateTime
  endDate       DateTime
  status        AcademicYearStatus @default(ACTIVE)
  isCurrent     Boolean            @default(false)
  createdAt     DateTime           @default(now())

  studentEnrollments      StudentEnrollment[]
  divisionAssignments     DivisionAssignment[]
  attendances             Attendance[]
  feeStructures           DivisionFeeStructure[]
  timetables              DivisionTimetable[]
  timetableSettings       TimetableSettings[]
  timeSlots               TimeSlot[]
  roomUnavailability      RoomUnavailability[]
  teacherAvailability     TeacherAvailability[]
  teacherTimetablePrefs   TeacherTimetablePref[]
  schoolTimetables        SchoolTimetable[]
  timetableSubjectConfigs TimetableSubjectConfig[]
  timetableEntries        TimetableEntry[]
  timetableExceptions     TimetableException[]
  timetableSubstitutions  TimetableSubstitution[]
  timetableGenerations    TimetableGeneration[]
  marksheets              Marksheet[]
  promotionBatches        PromotionBatch[]

  @@unique([institutionId, label])
  @@index([institutionId, isCurrent])
}

model StudentEnrollment {
  id             String        @id @default(uuid())
  institutionId  String
  institution    Institution   @relation(fields: [institutionId], references: [id])
  studentId      String
  student        Student       @relation(fields: [studentId], references: [id])
  academicYearId String
  academicYear   AcademicYear  @relation(fields: [academicYearId], references: [id])
  standardId     String
  standard       Standard      @relation(fields: [standardId], references: [id])
  divisionId     String
  division       Division      @relation(fields: [divisionId], references: [id])
  rollNo         String?
  status         StudentStatus
  createdAt      DateTime      @default(now())

  @@unique([studentId, academicYearId])
  @@index([divisionId, academicYearId])
  @@index([institutionId, academicYearId])
}

model DivisionTimetable {
  id             String       @id @default(uuid())
  institutionId  String
  institution    Institution  @relation(fields: [institutionId], references: [id])
  divisionId     String
  division       Division     @relation(fields: [divisionId], references: [id])
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  timetableUrl   String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([divisionId, academicYearId])
  @@index([institutionId, academicYearId])
}

model PromotionBatch {
  id              String                    @id @default(uuid())
  institutionId   String
  fromStandardId  String
  fromDivisionId  String
  toDivisionId    String?
  academicYearId  String
  academicYear    AcademicYear              @relation(fields: [academicYearId], references: [id])
  triggeredById   String
  triggeredByRole String
  undoneAt        DateTime?
  createdAt       DateTime                  @default(now())
  institution     Institution               @relation(fields: [institutionId], references: [id])
  outcomes        StudentPromotionOutcome[]

  @@index([institutionId, createdAt])
  @@index([fromDivisionId])
}

model StudentPromotionOutcome {
  id                 String           @id @default(uuid())
  batchId            String
  studentId          String
  institutionId      String
  outcome            PromotionOutcome
  previousStandardId String
  previousDivisionId String
  previousStatus     StudentStatus
  createdAt          DateTime         @default(now())
