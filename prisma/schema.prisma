generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  TEACHER
  STUDENT
}

enum InstitutionType {
  SCHOOL
  COLLEGE
  COACHING
}

enum InstitutionStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAUSED
  EXPIRED
  LOCKED
}

enum PaymentStatus {
  PAID
  PENDING
  FAILED
}

enum TeacherStatus {
  ACTIVE
  INACTIVE
}

enum StudentStatus {
  ACTIVE
  INACTIVE
}

enum CampusPostType {
  ANNOUNCEMENT
  NOTICE
  MATERIAL
  RESULT
}

enum CalendarEventType {
  HOLIDAY
  TEST
  EXAM
  SUBMISSION
}

// ─── Models ───────────────────────────────────────────────────────────────────

model Institution {
  id              String            @id @default(uuid())
  institutionCode String            @unique // e.g. QX-SCH-2026-0001
  name            String
  email           String            @unique
  type            InstitutionType
  status          InstitutionStatus @default(PENDING)

  // Contact & Location
  phone   String?
  city    String?
  state   String?
  address String?
  pincode String?
  country String? @default("India")

  // Academic Info
  board   String?
  medium  String?
  logoUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  subscription  Subscription?
  bills         Bill[]
  invites       Invite[]
  auditLogs     AuditLog[]
  notifications NotificationRecipient[]
  tickets       SupportTicket[]
  reviews       Review[]
  teachers      Teacher[]
  students      Student[]
  staffPosts    StaffPost[]
  staffMessages StaffMessage[]
  standards     Standard[]
  divisions     Division[]
  subjects      Subject[]
  assignments   DivisionAssignment[]
  campusPosts   CampusFeedPost[]
  calendarEvents CalendarEvent[]
}

model User {
  id       String  @id @default(uuid())
  name     String?
  email    String  @unique
  password String?
  role     Role
  isActive Boolean @default(false)

  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs          AuditLog[]
  teacher            Teacher?
  student            Student?
  staffPosts         StaffPost[]         @relation("StaffPostAuthor")
  staffPostReactions StaffPostReaction[] @relation("StaffPostReactionUser")
  staffPostComments  StaffPostComment[]  @relation("StaffPostCommentAuthor")
  sentMessages       StaffMessage[]      @relation("StaffMessageSender")
  receivedMessages   StaffMessage[]      @relation("StaffMessageReceiver")
  campusFeedPosts    CampusFeedPost[]    @relation("CampusFeedPostAuthor")
  calendarEvents     CalendarEvent[]     @relation("CalendarEventCreator")
}

enum TrialOutcome {
  EXTENDED
  ACTIVATED
  CHURNED
}

model Plan {
  id              String @id @default(uuid())
  name            String @unique
  basePrice       Float
  perStudentPrice Float

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]
}

model Subscription {
  id String @id @default(uuid())

  institutionId String      @unique
  institution   Institution @relation(fields: [institutionId], references: [id])

  planId String
  plan   Plan   @relation(fields: [planId], references: [id])

  // Trial tracking
  trialDays           Int?          // number of trial days set by superadmin
  trialOutcome        TrialOutcome? // what happened after trial ended
  trialWarningSent    Boolean       @default(false)
  trialExpiryNotified Boolean       @default(false)

  status        SubscriptionStatus @default(TRIAL)
  paymentStatus PaymentStatus      @default(PENDING)
  discount      Float              @default(0)
  features      Json?

  activationDate  DateTime? // billing anchor — set when plan transitions from TRIAL to ACTIVE
  pausedAt        DateTime?
  pauseMonthsUsed Int       @default(0)
  addons          Json?

  startDate DateTime? // null = trial created but not yet activated
  endDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Bill {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])

  type         String
  billingMonth String?

  userCount      Int   @default(0)
  baseAmount     Float @default(0)
  addonAmount    Float @default(0)
  discountAmount Float @default(0)
  totalAmount    Float

  status PaymentStatus @default(PENDING)
  items  Json // BillItem[]

  generatedAt DateTime  @default(now())
  dueDate     DateTime?
  paidAt      DateTime?
}

model Invite {
  id String @id @default(uuid())

  email     String
  tokenHash String @unique
  role      Role

  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])

  expiresAt DateTime
  isUsed    Boolean  @default(false)

  createdAt DateTime @default(now())
}

model Teacher {
  id        String @id @default(uuid())
  teacherId String

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])

  phone         String?
  avatarUrl     String?
  dob           String?
  gender        String?
  address       String?
  city          String?
  state         String?
  pincode       String?
  country       String?       @default("India")
  qualification String?
  experience    String?

  status   TeacherStatus @default(ACTIVE)
  joinedAt DateTime      @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments DivisionAssignment[]

  @@unique([teacherId, institutionId])
  @@index([institutionId])
}

model Student {
  id        String @id @default(uuid())
  studentId String

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])

  standardId String?
  standard   Standard? @relation(fields: [standardId], references: [id], onDelete: SetNull)

  divisionId String?
  division   Division? @relation(fields: [divisionId], references: [id], onDelete: SetNull)

  phone    String?
  avatarUrl String?
  dob      String?
  gender   String?
  address  String?
  city     String?
  state    String?
  pincode  String?
  country  String? @default("India")

  status   StudentStatus @default(ACTIVE)
  joinedAt DateTime      @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, institutionId])
  @@index([institutionId])
}

model AuditLog {
  id            String  @id @default(uuid())
  action        String
  userId        String?
  actorRole     String?
  institutionId String?
  details       String?
  ip            String?
  metadata      Json?

  user        User?        @relation(fields: [userId], references: [id])
  institution Institution? @relation(fields: [institutionId], references: [id])

  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([action])
  @@index([actorRole])
  @@index([institutionId])
}

model Notification {
  id            String  @id @default(uuid())
  title         String
  message       String
  tag           String
  recipientType String
  deliveredTo   Int     @default(0)
  sentById      String?

  recipients NotificationRecipient[]

  createdAt DateTime @default(now())
}

model NotificationRecipient {
  id             String       @id @default(uuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id])
  institutionId  String
  institution    Institution  @relation(fields: [institutionId], references: [id])
  readAt         DateTime?
  dismissedAt    DateTime?

  @@index([institutionId, readAt])
  @@index([institutionId, dismissedAt])
}

model SupportTicket {
  id          String @id @default(uuid())
  title       String
  description String
  category    String
  priority    String
  status      String @default("OPEN")

  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  adminEmail    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  replies TicketReply[]
}

model TicketReply {
  id       String        @id @default(uuid())
  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id])

  author  String
  role    String
  message String

  createdAt DateTime @default(now())
}

model Review {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])

  adminName    String
  adminEmail   String
  rating       Int
  title        String
  body         String
  likes        Int     @default(0)
  replyMessage String?

  repliedAt DateTime?
  createdAt DateTime  @default(now())
}

// ─── Staffroom ────────────────────────────────────────────────────────────────

model StaffPost {
  id             String  @id @default(uuid())
  institutionId  String
  authorId       String
  text           String
  attachmentUrl  String?
  attachmentType String? // "image" | "file"
  attachmentName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institution Institution       @relation(fields: [institutionId], references: [id])
  author      User              @relation("StaffPostAuthor", fields: [authorId], references: [id])
  reactions   StaffPostReaction[]
  comments    StaffPostComment[]

  @@index([institutionId, createdAt(sort: Desc)])
}

model StaffPostReaction {
  id            String   @id @default(uuid())
  postId        String
  userId        String
  institutionId String
  createdAt     DateTime @default(now())

  post StaffPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User      @relation("StaffPostReactionUser", fields: [userId], references: [id])

  @@unique([postId, userId])
  @@index([institutionId])
}

model StaffPostComment {
  id            String   @id @default(uuid())
  postId        String
  authorId      String
  institutionId String
  text          String
  createdAt     DateTime @default(now())

  post   StaffPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User      @relation("StaffPostCommentAuthor", fields: [authorId], references: [id])

  @@index([postId])
  @@index([institutionId])
}

model StaffMessage {
  id             String    @id @default(uuid())
  institutionId  String
  senderId       String
  receiverId     String
  text           String?
  attachmentUrl  String?
  attachmentType String?
  attachmentName String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  institution Institution @relation(fields: [institutionId], references: [id])
  sender      User        @relation("StaffMessageSender", fields: [senderId], references: [id])
  receiver    User        @relation("StaffMessageReceiver", fields: [receiverId], references: [id])

  @@index([institutionId])
  @@index([senderId, receiverId])
  @@index([createdAt(sort: Desc)])
}

// ─── Campus ───────────────────────────────────────────────────────────────────

model Standard {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])

  name  String
  order Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  divisions Division[]
  students  Student[]

  @@unique([institutionId, name])
  @@index([institutionId])
}

model Division {
  id         String   @id @default(uuid())
  standardId String
  standard   Standard @relation(fields: [standardId], references: [id], onDelete: Cascade)

  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])

  name     String
  capacity Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subjects    Subject[]
  assignments DivisionAssignment[]
  students    Student[]

  @@unique([standardId, name])
  @@index([institutionId])
}

model Subject {
  id         String   @id @default(uuid())
  divisionId String
  division   Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)

  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])

  name  String
  code  String?
  color String?
  order Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments DivisionAssignment[]

  @@unique([divisionId, name])
  @@index([institutionId])
}

model DivisionAssignment {
  id         String   @id @default(uuid())
  divisionId String
  division   Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)

  // null = class teacher slot; set = subject teacher for that subject
  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])

  createdAt DateTime @default(now())

  @@unique([divisionId, subjectId])
  @@index([institutionId])
  @@index([teacherId])
}

// ─── Campus Feed ──────────────────────────────────────────────────────────────

model CampusFeedPost {
  id            String         @id @default(uuid())
  institutionId String
  institution   Institution    @relation(fields: [institutionId], references: [id])

  type          CampusPostType
  title         String
  body          String
  subject       String?

  attachmentUrl  String?
  attachmentType String?
  attachmentName String?

  authorId String
  author   User   @relation("CampusFeedPostAuthor", fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([institutionId, createdAt(sort: Desc)])
}

model CalendarEvent {
  id            String            @id @default(uuid())
  institutionId String
  institution   Institution       @relation(fields: [institutionId], references: [id])

  type  CalendarEventType
  label String
  date  DateTime

  createdById String?
  createdBy   User?   @relation("CalendarEventCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([institutionId, date])
}
